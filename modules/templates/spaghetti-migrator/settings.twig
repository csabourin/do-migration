{% import "_includes/forms" as forms %}

{# Settings page styles — conservative, Craft-native aesthetic #}
<style>
/* -------------------------
   Layout & Container
   ------------------------- */
.sp-settings {
    max-width: 900px;
    margin: 0 auto;
}

/* -------------------------
   Intro Section
   ------------------------- */
.sp-intro {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 20px 24px;
    margin-bottom: 28px;
}

.sp-intro h1 {
    margin: 0 0 8px 0;
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
}

.sp-intro p {
    margin: 0 0 10px 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
}

.sp-intro p:last-child { margin-bottom: 0; }

.sp-tip {
    display: flex;
    gap: 10px;
    background: #eff6ff;
    border-left: 3px solid #3b82f6;
    border-radius: 0 6px 6px 0;
    padding: 12px 16px;
    margin-top: 14px;
    font-size: 13px;
    color: #1e40af;
    line-height: 1.55;
}

.sp-tip code {
    background: #dbeafe;
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 12px;
    font-family: 'SF Mono', 'Menlo', 'Monaco', monospace;
    color: #1e3a8a;
}

/* -------------------------
   Cards
   ------------------------- */
.sp-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-bottom: 20px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
}

.sp-card-head {
    padding: 16px 22px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fafbfc;
}

.sp-card-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
    background: #e0e7ff;
}

.sp-card-head h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
}

.sp-card-head p {
    margin: 0;
    font-size: 12.5px;
    color: #94a3b8;
    font-weight: 400;
    margin-left: auto;
}

.sp-card-body {
    padding: 22px;
}

/* -------------------------
   Two-column grid for related fields
   ------------------------- */
.sp-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
    align-items: start;
}

.sp-field-row-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0 18px;
    align-items: start;
}

@media (max-width: 640px) {
    .sp-field-row,
    .sp-field-row-3 {
        grid-template-columns: 1fr;
    }
}

/* -------------------------
   Sub-group label (for logical clusters inside a card)
   ------------------------- */
.sp-subgroup {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid #f1f5f9;
}

.sp-subgroup-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #94a3b8;
    margin: 0 0 14px 0;
}

/* -------------------------
   Info note
   ------------------------- */
.sp-note {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 14px 16px;
    font-size: 12.5px;
    color: #475569;
    line-height: 1.65;
    margin-top: 16px;
}

.sp-note strong {
    display: block;
    color: #1e293b;
    margin-bottom: 6px;
    font-size: 13px;
}

.sp-note code {
    background: #e2e8f0;
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 12px;
    font-family: 'SF Mono', 'Menlo', 'Monaco', monospace;
    color: #1e293b;
}

/* -------------------------
   Section divider
   ------------------------- */
.sp-divider {
    height: 1px;
    background: #e2e8f0;
    margin: 28px 0;
}

/* -------------------------
   Import / Export Section
   ------------------------- */
.sp-import-export {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
    margin-top: 28px;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
}

.sp-import-export-head {
    padding: 18px 24px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}

.sp-import-export-head h2 {
    margin: 0 0 4px 0;
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
}

.sp-import-export-head p {
    margin: 0;
    font-size: 13px;
    color: #64748b;
}

.sp-import-export-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
}

@media (max-width: 640px) {
    .sp-import-export-grid { grid-template-columns: 1fr; }
}

.sp-ie-card {
    padding: 22px 24px;
}

.sp-ie-card + .sp-ie-card {
    border-left: 1px solid #e2e8f0;
}

@media (max-width: 640px) {
    .sp-ie-card + .sp-ie-card {
        border-left: none;
        border-top: 1px solid #e2e8f0;
    }
}

.sp-ie-card h3 {
    margin: 0 0 8px 0;
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
}

.sp-ie-card p {
    margin: 0 0 16px 0;
    font-size: 13px;
    color: #64748b;
    line-height: 1.55;
}

.sp-export-btn {
    display: inline-block;
    padding: 9px 20px;
    background: #1e293b;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background .15s;
}

.sp-export-btn:hover { background: #0f172a; text-decoration: none; }

.sp-file-input-wrap {
    margin-bottom: 12px;
}

.sp-file-input-wrap input[type="file"] {
    width: 100%;
    padding: 9px 12px;
    background: #f8fafc;
    border: 1.5px dashed #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
    transition: border-color .15s;
    color: #475569;
}

.sp-file-input-wrap input[type="file"]:hover {
    border-color: #94a3b8;
}

.sp-import-btn {
    width: 100%;
    padding: 9px 20px;
    background: #3b82f6;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s;
}

.sp-import-btn:hover { background: #2563eb; }
.sp-import-btn:disabled { background: #94a3b8; cursor: not-allowed; }

.sp-import-btn.loading {
    position: relative;
    color: transparent;
}

.sp-import-btn.loading::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    top: 50%;
    left: 50%;
    margin: -8px 0 0 -8px;
    border: 2px solid rgba(255,255,255,.35);
    border-top-color: white;
    border-radius: 50%;
    animation: sp-spin .6s linear infinite;
}

@keyframes sp-spin { to { transform: rotate(360deg); } }
</style>

<div class="sp-settings">

    {# ── Intro ── #}
    <div class="sp-intro">
        <h1>Spaghetti Migrator</h1>
        <p>Configure cloud migration settings. Settings are split into <strong>Frequently Changed</strong> — the options you'll touch most — and <strong>Good Defaults</strong> for advanced tuning that rarely needs adjustment.</p>
        <div class="sp-tip">
            <span>&#128274;</span>
            <span>
                Store credentials in your <code>.env</code> file and reference them here.
                E.g. <code>$AWS_SOURCE_BUCKET</code>, <code>$DO_S3_BUCKET</code>, <code>$DO_S3_ACCESS_KEY</code>, <code>$DO_S3_SECRET_KEY</code>.
            </span>
        </div>
    </div>

    {# ── Tab Navigation ── #}
    {% set settingsUrl = 'settings/plugins/spaghetti-migrator' %}
    {% set tabs = {
        'frequently-changed': {
            label: "Frequently Changed"|t('spaghetti-migrator'),
            url: url(settingsUrl, { tab: 'frequently-changed' })
        },
        'good-defaults': {
            label: "Good Defaults"|t('spaghetti-migrator'),
            url: url(settingsUrl, { tab: 'good-defaults' })
        }
    } %}

    {% set requestedTab = craft.app.request.getParam('tab') %}
    {% set selectedTab = requestedTab and requestedTab in tabs|keys ? requestedTab : 'frequently-changed' %}

    {{ include('_includes/tabs', {
        tabs: tabs,
        selectedTab: selectedTab
    }) }}


    {# ============================================================ #}
    {# TAB 1: FREQUENTLY CHANGED                                     #}
    {# ============================================================ #}

    <div id="frequently-changed"{% if selectedTab != 'frequently-changed' %} class="hidden"{% endif %}>

        {# ── AWS Source ── #}
        <div class="sp-card">
            <div class="sp-card-head">
                <div class="sp-card-icon">☁️</div>
                <h2>AWS Source</h2>
                <p>S3 bucket you're migrating from</p>
            </div>
            <div class="sp-card-body">

                <div class="sp-field-row">
                    {{ forms.autosuggestField({
                        label: "Bucket Name"|t('spaghetti-migrator'),
                        instructions: "Set via <code>AWS_SOURCE_BUCKET</code>."|t('spaghetti-migrator'),
                        id: 'awsBucket',
                        name: 'awsBucket',
                        value: settings.awsBucket,
                        suggestEnvVars: true,
                        required: true,
                        errors: settings.getErrors('awsBucket')
                    }) }}

                    {{ forms.selectField({
                        label: "Region"|t('spaghetti-migrator'),
                        instructions: "AWS region where the bucket is hosted."|t('spaghetti-migrator'),
                        id: 'awsRegion',
                        name: 'awsRegion',
                        value: settings.awsRegion,
                        required: true,
                        options: {
                            'us-east-1': 'US East — N. Virginia (us-east-1)',
                            'us-east-2': 'US East — Ohio (us-east-2)',
                            'us-west-1': 'US West — N. California (us-west-1)',
                            'us-west-2': 'US West — Oregon (us-west-2)',
                            'ca-central-1': 'Canada — Central (ca-central-1)',
                            'eu-west-1': 'Europe — Ireland (eu-west-1)',
                            'eu-west-2': 'Europe — London (eu-west-2)',
                            'eu-west-3': 'Europe — Paris (eu-west-3)',
                            'eu-central-1': 'Europe — Frankfurt (eu-central-1)',
                            'ap-south-1': 'Asia Pacific — Mumbai (ap-south-1)',
                            'ap-southeast-1': 'Asia Pacific — Singapore (ap-southeast-1)',
                            'ap-southeast-2': 'Asia Pacific — Sydney (ap-southeast-2)',
                            'ap-northeast-1': 'Asia Pacific — Tokyo (ap-northeast-1)',
                            'ap-northeast-2': 'Asia Pacific — Seoul (ap-northeast-2)',
                            'sa-east-1': 'South America — São Paulo (sa-east-1)',
                        },
                        errors: settings.getErrors('awsRegion')
                    }) }}
                </div>

                <div class="sp-subgroup">
                    <p class="sp-subgroup-label">Credentials (env references only — never store secrets directly)</p>
                    <div class="sp-field-row">
                        {{ forms.autosuggestField({
                            label: "Access Key Env Ref"|t('spaghetti-migrator'),
                            instructions: "e.g. <code>$AWS_ACCESS_KEY_ID</code>"|t('spaghetti-migrator'),
                            id: 'awsAccessKeyEnvRef',
                            name: 'awsAccessKeyEnvRef',
                            value: settings.awsAccessKeyEnvRef,
                            suggestEnvVars: true,
                            errors: settings.getErrors('awsAccessKeyEnvRef')
                        }) }}

                        {{ forms.autosuggestField({
                            label: "Secret Key Env Ref"|t('spaghetti-migrator'),
                            instructions: "e.g. <code>$AWS_SECRET_ACCESS_KEY</code>"|t('spaghetti-migrator'),
                            id: 'awsSecretKeyEnvRef',
                            name: 'awsSecretKeyEnvRef',
                            value: settings.awsSecretKeyEnvRef,
                            suggestEnvVars: true,
                            errors: settings.getErrors('awsSecretKeyEnvRef')
                        }) }}
                    </div>
                </div>

            </div>
        </div>

        {# ── DigitalOcean Target ── #}
        <div class="sp-card">
            <div class="sp-card-head">
                <div class="sp-card-icon">🌊</div>
                <h2>DigitalOcean Target</h2>
                <p>Spaces bucket you're migrating to</p>
            </div>
            <div class="sp-card-body">

                <div class="sp-field-row">
                    {{ forms.selectField({
                        label: "Region"|t('spaghetti-migrator'),
                        instructions: "Must match your DO Spaces bucket region."|t('spaghetti-migrator'),
                        id: 'doRegion',
                        name: 'doRegion',
                        value: settings.doRegion,
                        required: true,
                        options: {
                            'nyc3': 'New York City (nyc3)',
                            'ams3': 'Amsterdam (ams3)',
                            'sgp1': 'Singapore (sgp1)',
                            'sfo3': 'San Francisco (sfo3)',
                            'fra1': 'Frankfurt (fra1)',
                            'tor1': 'Toronto (tor1)',
                        },
                        errors: settings.getErrors('doRegion')
                    }) }}

                    {{ forms.autosuggestField({
                        label: "Region Env Ref (override)"|t('spaghetti-migrator'),
                        instructions: "Optional — overrides the dropdown above if it resolves."|t('spaghetti-migrator'),
                        id: 'doRegionEnvRef',
                        name: 'doRegionEnvRef',
                        value: settings.doRegionEnvRef,
                        suggestEnvVars: true,
                        errors: settings.getErrors('doRegionEnvRef')
                    }) }}
                </div>

                <div class="sp-subgroup">
                    <p class="sp-subgroup-label">Bucket &amp; URL</p>
                    <div class="sp-field-row">
                        {{ forms.autosuggestField({
                            label: "Bucket Env Ref"|t('spaghetti-migrator'),
                            instructions: "e.g. <code>$DO_S3_BUCKET</code>"|t('spaghetti-migrator'),
                            id: 'doBucketEnvRef',
                            name: 'doBucketEnvRef',
                            value: settings.doBucketEnvRef,
                            suggestEnvVars: true,
                            errors: settings.getErrors('doBucketEnvRef')
                        }) }}

                        {{ forms.autosuggestField({
                            label: "Base URL Env Ref"|t('spaghetti-migrator'),
                            instructions: "e.g. <code>$DO_S3_BASE_URL</code>"|t('spaghetti-migrator'),
                            id: 'doBaseUrlEnvRef',
                            name: 'doBaseUrlEnvRef',
                            value: settings.doBaseUrlEnvRef,
                            suggestEnvVars: true,
                            errors: settings.getErrors('doBaseUrlEnvRef')
                        }) }}
                    </div>
                </div>

                <div class="sp-subgroup">
                    <p class="sp-subgroup-label">Credentials</p>
                    <div class="sp-field-row">
                        {{ forms.autosuggestField({
                            label: "Access Key Env Ref"|t('spaghetti-migrator'),
                            instructions: "e.g. <code>$DO_S3_ACCESS_KEY</code>"|t('spaghetti-migrator'),
                            id: 'doAccessKeyEnvRef',
                            name: 'doAccessKeyEnvRef',
                            value: settings.doAccessKeyEnvRef,
                            suggestEnvVars: true,
                            errors: settings.getErrors('doAccessKeyEnvRef')
                        }) }}

                        {{ forms.autosuggestField({
                            label: "Secret Key Env Ref"|t('spaghetti-migrator'),
                            instructions: "e.g. <code>$DO_S3_SECRET_KEY</code>"|t('spaghetti-migrator'),
                            id: 'doSecretKeyEnvRef',
                            name: 'doSecretKeyEnvRef',
                            value: settings.doSecretKeyEnvRef,
                            suggestEnvVars: true,
                            errors: settings.getErrors('doSecretKeyEnvRef')
                        }) }}
                    </div>
                </div>

                <div class="sp-subgroup">
                    {{ forms.autosuggestField({
                        label: "SDK Endpoint Env Ref"|t('spaghetti-migrator'),
                        instructions: "Region-only endpoint, e.g. <code>$DO_S3_BASE_ENDPOINT</code> → <code>https://nyc3.digitaloceanspaces.com</code>"|t('spaghetti-migrator'),
                        id: 'doEndpointEnvRef',
                        name: 'doEndpointEnvRef',
                        value: settings.doEndpointEnvRef,
                        suggestEnvVars: true,
                        errors: settings.getErrors('doEndpointEnvRef')
                    }) }}
                </div>

                <div class="sp-note">
                    <strong>Recommended .env values</strong>
                    <code>{{ settings.doBucketEnvRef|default('DO_S3_BUCKET') }}=your-bucket-name</code><br>
                    <code>{{ settings.doBaseUrlEnvRef|default('DO_S3_BASE_URL') }}=https://your-bucket.{{ settings.doRegion }}.digitaloceanspaces.com</code><br>
                    <code>{{ settings.doAccessKeyEnvRef|default('DO_S3_ACCESS_KEY') }}=your-access-key</code><br>
                    <code>{{ settings.doSecretKeyEnvRef|default('DO_S3_SECRET_KEY') }}=your-secret-key</code><br>
                    <code>{{ settings.doEndpointEnvRef|default('DO_S3_BASE_ENDPOINT') }}=https://{{ settings.doRegion }}.digitaloceanspaces.com</code>
                </div>

            </div>
        </div>

        {# ── Filesystem Mappings ── #}
        <div class="sp-card">
            <div class="sp-card-head">
                <div class="sp-card-icon">🗂️</div>
                <h2>Filesystem Mappings</h2>
                <p>Map AWS FS handles to DO FS handles</p>
            </div>
            <div class="sp-card-body">
                {{ forms.textareaField({
                    label: "Mappings (JSON)"|t('spaghetti-migrator'),
                    instructions: "Format: <code>{\"aws_handle\": \"do_handle\", \"images\": \"images_do\"}</code>"|t('spaghetti-migrator'),
                    id: 'filesystemMappings',
                    name: 'filesystemMappings',
                    value: settings.filesystemMappings|json_encode(constant('JSON_PRETTY_PRINT')),
                    required: true,
                    rows: 5,
                    class: 'code',
                    errors: settings.getErrors('filesystemMappings')
                }) }}
            </div>
        </div>

        {# ── Volume Configuration ── #}
        <div class="sp-card">
            <div class="sp-card-head">
                <div class="sp-card-icon">📦</div>
                <h2>Volume Configuration</h2>
                <p>Which volumes to migrate and how to organize them</p>
            </div>
            <div class="sp-card-body">

                <div class="sp-subgroup" style="margin-top:0; padding-top:0; border-top:none;">
                    <p class="sp-subgroup-label">Core volumes</p>
                    <div class="sp-field-row">
                        {{ forms.textField({
                            label: "Source Volume Handles"|t('spaghetti-migrator'),
                            instructions: "Comma-separated handles to migrate from."|t('spaghetti-migrator'),
                            id: 'sourceVolumeHandles',
                            name: 'sourceVolumeHandles',
                            value: settings.sourceVolumeHandles|join(', '),
                            required: true,
                            errors: settings.getErrors('sourceVolumeHandles')
                        }) }}

                        {{ forms.textField({
                            label: "Target Volume Handle"|t('spaghetti-migrator'),
                            instructions: "Consolidation destination."|t('spaghetti-migrator'),
                            id: 'targetVolumeHandle',
                            name: 'targetVolumeHandle',
                            value: settings.targetVolumeHandle,
                            required: true,
                            errors: settings.getErrors('targetVolumeHandle')
                        }) }}
                    </div>

                    <div class="sp-field-row">
                        {{ forms.textField({
                            label: "Documents Volume Handle"|t('spaghetti-migrator'),
                            instructions: "PDF / DOCX / ZIP / TXT repair workflows."|t('spaghetti-migrator'),
                            id: 'documentsVolumeHandle',
                            name: 'documentsVolumeHandle',
                            value: settings.documentsVolumeHandle,
                            errors: settings.getErrors('documentsVolumeHandle')
                        }) }}

                        {{ forms.textField({
                            label: "Quarantine Volume Handle"|t('spaghetti-migrator'),
                            instructions: "Stores unused / orphaned assets."|t('spaghetti-migrator'),
                            id: 'quarantineVolumeHandle',
                            name: 'quarantineVolumeHandle',
                            value: settings.quarantineVolumeHandle,
                            required: true,
                            errors: settings.getErrors('quarantineVolumeHandle')
                        }) }}
                    </div>

                    {{ forms.textField({
                        label: "Optimised Images Volume Handle"|t('spaghetti-migrator'),
                        instructions: "Volume for generated image variants before consolidation."|t('spaghetti-migrator'),
                        id: 'optimisedImagesVolumeHandle',
                        name: 'optimisedImagesVolumeHandle',
                        value: settings.optimisedImagesVolumeHandle,
                        errors: settings.getErrors('optimisedImagesVolumeHandle')
                    }) }}
                </div>

                <div class="sp-subgroup">
                    <p class="sp-subgroup-label">Folder structure</p>
                    <div class="sp-field-row">
                        {{ forms.textField({
                            label: "Volumes at Bucket Root"|t('spaghetti-migrator'),
                            instructions: "Comma-separated — not nested in a subfolder."|t('spaghetti-migrator'),
                            id: 'volumesAtBucketRoot',
                            name: 'volumesAtBucketRoot',
                            value: settings.volumesAtBucketRoot|join(', '),
                            errors: settings.getErrors('volumesAtBucketRoot')
                        }) }}

                        {{ forms.textField({
                            label: "Volumes with Subfolders"|t('spaghetti-migrator'),
                            instructions: "Comma-separated — contain internal subfolder trees."|t('spaghetti-migrator'),
                            id: 'volumesWithSubfolders',
                            name: 'volumesWithSubfolders',
                            value: settings.volumesWithSubfolders|join(', '),
                            errors: settings.getErrors('volumesWithSubfolders')
                        }) }}
                    </div>

                    <div class="sp-field-row">
                        {{ forms.textField({
                            label: "Flat Structure Volumes"|t('spaghetti-migrator'),
                            instructions: "Comma-separated — all files at root, no subfolders."|t('spaghetti-migrator'),
                            id: 'volumesFlatStructure',
                            name: 'volumesFlatStructure',
                            value: settings.volumesFlatStructure|join(', '),
                            errors: settings.getErrors('volumesFlatStructure')
                        }) }}

                        {{ forms.textField({
                            label: "Flattenable Volumes"|t('spaghetti-migrator'),
                            instructions: "Comma-separated — allowed to be flattened by consolidation."|t('spaghetti-migrator'),
                            id: 'volumesFlattenable',
                            name: 'volumesFlattenable',
                            value: settings.volumesFlattenable|join(', '),
                            errors: settings.getErrors('volumesFlattenable')
                        }) }}
                    </div>
                </div>

                <div class="sp-subgroup">
                    {{ forms.textField({
                        label: "Quarantine Safety Threshold (%)"|t('spaghetti-migrator'),
                        instructions: "Warn and block auto-confirm when this % of assets would be quarantined."|t('spaghetti-migrator'),
                        id: 'quarantineSafetyThresholdPercent',
                        name: 'quarantineSafetyThresholdPercent',
                        type: 'number',
                        value: settings.quarantineSafetyThresholdPercent,
                        min: 0,
                        max: 100,
                        errors: settings.getErrors('quarantineSafetyThresholdPercent'),
                        size: 6
                    }) }}
                </div>

            </div>
        </div>

        {# ── Filesystem Definitions ── #}
        <div class="sp-card">
            <div class="sp-card-head">
                <div class="sp-card-icon">⚙️</div>
                <h2>Filesystem Definitions</h2>
                <p>DO Spaces filesystems to create</p>
            </div>
            <div class="sp-card-body">
                {{ forms.textareaField({
                    label: "Filesystem Definitions (JSON array)"|t('spaghetti-migrator'),
                    instructions: 'Format: <code>[{"handle":"…","name":"…","subfolder":"$ENV_VAR","hasUrls":true}]</code>'|t('spaghetti-migrator'),
                    id: 'filesystemDefinitions',
                    name: 'filesystemDefinitions',
                    value: settings.filesystemDefinitions|json_encode(constant('JSON_PRETTY_PRINT')),
                    rows: 12,
                    class: 'code',
                    errors: settings.getErrors('filesystemDefinitions')
                }) }}

                <div class="sp-subgroup">
                    <p class="sp-subgroup-label">Special filesystem handles</p>
                    <div class="sp-field-row">
                        {{ forms.textField({
